# Vorlage für die Umgebungsvariablen.
# Lokal: diese Datei als .env.local kopieren und echte Werte eintragen (.env.local kommt nie ins Git-Repo).
# Online: dieselben Namen und Werte bei Vercel unter Settings → Environment Variables eintragen.

# Supabase: Dashboard → oben „Connect“ → App Frameworks → Next.js
# Beide Werte sind öffentlich gedacht (sie landen im Browser). Geschützt werden die Daten
# durch den Login und die Zeilenrechte (Row Level Security) in der Datenbank.
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# KI (nur auf dem Server, nie im Browser). Anbieter austauschbar, siehe lib/ai/server.ts
AI_PROVIDER=groq
# GEHEIM: Schlüssel aus https://console.groq.com → API Keys (kostenloser Tarif, keine Zahlungsdaten!)
GROQ_API_KEY=gsk_...
# Modelle: eins mit Bild-Verständnis, eins für reinen Text (Liste: GET https://api.groq.com/openai/v1/models)
AI_MODEL_VISION=qwen/qwen3.8-27b
AI_MODEL_SMALL=openai/gpt-oss-20b
# Größeres Textmodell für Kochvorschläge (ab Phase 3); fehlt es, wird AI_MODEL_SMALL genommen
AI_MODEL_TEXT=openai/gpt-oss-120b
# Eigenes Tageslimit der App für KI-Aufrufe
AI_DAILY_LIMIT=50

# GEHEIM: Schlüssel für den täglichen Weckruf (Vercel Cron → /api/keepalive), der Supabase wach hält.
# Beliebige lange Zufallszeichenkette (mind. 16 Zeichen). Nur bei Vercel nötig, lokal nicht.
CRON_SECRET=
